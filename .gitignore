# Python virtual environment
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Input, output & personal PDF/CSV storage directories (keep empty folders via .gitkeep)
new/*
!new/.gitkeep
scraped/*
!scraped/.gitkeep
scraped_stored/
scraped_stored/*
logten pro format/*
!logten pro format/.gitkeep
times/
converted_times/
scratch/
scratch/*

# Local agent worktrees & session artifacts
.claude/
_artifacts/

# OS metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDE settings
.idea/
.vscode/
*.swp
*.swo
